<%- include('../partials/header') %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-icon-badge">📬</div>
      <h2 class="auth-title">Verify Your Email Address</h2>
      <p class="auth-subtitle">Enter the 6-digit verification code sent to your inbox</p>
    </div>

    <% if (notice) { %>
      <div class="alert-box alert-info">
        <div class="alert-icon">ℹ️</div>
        <div class="alert-text"><%= notice %></div>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert-box alert-error">
        <div class="alert-icon">⚠️</div>
        <div class="alert-text"><%= error %></div>
      </div>
    <% } %>

    <form action="/verify-otp" method="POST" class="auth-form">
      <div class="form-group">
        <label for="email" class="form-label">Registered Email</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-input" 
          value="<%= email %>" 
          placeholder="name@example.com" 
          required
        >
      </div>

      <div class="form-group">
        <label for="otp" class="form-label">6-Digit Verification OTP</label>
        <div class="otp-input-wrapper">
          <input 
            type="text" 
            id="otp" 
            name="otp" 
            class="form-input otp-field" 
            placeholder="• • • • • •" 
            maxlength="6" 
            pattern="\d{6}" 
            required 
            autofocus
            autocomplete="one-time-code"
          >
        </div>
        <span class="input-helper">Valid for 10 minutes. Check your spam/junk folder if not visible immediately.</span>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">
        <span>Verify &amp; Activate Account ✓</span>
      </button>
    </form>

    <div class="resend-wrapper">
      <span>Didn't receive the code?</span>
      <form action="/resend-otp" method="POST" class="inline-form">
        <input type="hidden" name="email" value="<%= email %>">
        <button type="submit" class="btn-link">Resend New OTP</button>
      </form>
    </div>

    <div class="auth-footer-links">
      <a href="/login" class="link-subtle">&larr; Back to Login</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>